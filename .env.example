# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
#
# After installing PostgreSQL locally:
#   1. Open pgAdmin 4 or psql shell
#   2. Create database: CREATE DATABASE upsc_rag;
#   3. Update the password below to match what you set during installation
#
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/upsc_rag

# Qdrant vector database (running in Docker)
# docker run -d --name qdrant_db -p 6333:6333 -p 6334:6334 -v qdrant_storage:/qdrant/storage qdrant/qdrant:latest
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Embedding model (BAAI/bge-base-en-v1.5 is the default)
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5

# Gemini 3.5 Flash API key (required for Endpoint 2: POST /api/v2/documents)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API key (optional, used as alternative chatbot generator model)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-specdec

